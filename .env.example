# Copy to .env and fill in local values. Never commit .env.
MODEL_PROVIDER=remote

# Remote OpenAI-compatible model; required when MODEL_PROVIDER=remote.
MODEL_LINE_NAME=qwen3.6-flash
DASHSCOPE_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local Ollama alternative; used when MODEL_PROVIDER=local.
OLLAMA_MODEL_NAME=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# MySQL database used for session history.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=reply_agent
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=reply_agent
MYSQL_CHARSET=utf8mb4

# Project vector storage and optional speech recognition.
CHROMA_PATH=./data/chroma
VOSK_PATH=./models/vosk-model-cn-0.22

# Users download models themselves; weights are not included in this repository.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=false